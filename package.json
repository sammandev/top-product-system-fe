{
  "name": "ast-tools-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "preinstall": "node -e \"if (!process.env.npm_config_user_agent?.startsWith('pnpm/')) { console.error('Use pnpm: corepack enable && pnpm install'); process.exit(1); }\"",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "docs:primevue": "node scripts/sync-primevue-docs.mjs",
    "icons:build": "node scripts/build-icons.mjs",
    "prebuild": "node scripts/build-icons.mjs",
    "lint": "biome lint . --diagnostic-level=warn",
    "lint:fix": "biome lint . --write",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "type-check": "vue-tsc -b --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@iconify/vue": "^5.0.5",
    "@primeuix/themes": "^3.1.0",
    "@tanstack/vue-query": "^5.107.1",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.21.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "idb": "^8.0.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "katex": "^0.19.1",
    "pinia": "^4.1.0",
    "primevue": "^5.0.4",
    "vue": "^3.5.45",
    "vue-echarts": "^8.3.2",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@iconify/json": "^2.2.554",
    "@iconify/utils": "^3.1.7",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^21.0.4",
    "npm-check-updates": "^23.1.1",
    "pnpm": "^12.18.0",
    "tailwindcss": "^4.3.5",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@12.16.1"
}
