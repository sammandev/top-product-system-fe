{
  "name": "ast-tools-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "preinstall": "node -e \"if (!process.env.npm_config_user_agent?.startsWith('pnpm/')) { console.error('Use pnpm: corepack enable && pnpm install'); process.exit(1); }\"",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "docs:primevue": "node scripts/sync-primevue-docs.mjs",
    "icons:build": "node scripts/build-icons.mjs",
    "prebuild": "node scripts/build-icons.mjs",
    "lint": "biome lint . --diagnostic-level=warn",
    "lint:fix": "biome lint . --write",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "type-check": "vue-tsc -b --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@iconify/vue": "^5.0.1",
    "@primeuix/themes": "^3.0.0",
    "@sentry/vue": "^10.72.0",
    "@tanstack/vue-query": "^5.102.8",
    "@vueuse/core": "^14.4.0",
    "@vueuse/motion": "^3.0.3",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "katex": "^0.18.4",
    "lodash-es": "^4.18.1",
    "pinia": "^4.0.3",
    "primevue": "^5.0.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.42",
    "vue-echarts": "^8.2.0",
    "vue-router": "^5.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@iconify/json": "^2.2.522",
    "@iconify/utils": "^3.1.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.12.0",
    "msw": "^2.15.0",
    "npm-check-updates": "^22.2.9",
    "pnpm": "^11.24.0",
    "sass": "^1.103.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@11.24.0"
}
