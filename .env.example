# Frontend Environment Configuration Template
# Copy to .env.local, .env.development, .env.production, or .env.staging locally.
# Restart Vite after edits, or rebuild the frontend for deployed environments.
# VITE_ values are visible in browser bundles. Do not put secret credentials or tokens here.

# Backend origin for regular API calls and streaming calls, respectively.
# For the backend development server on port 8001, set both URLs to http://127.0.0.1:8001.
VITE_API_BASE_URL=http://127.0.0.1:7070
VITE_API_URL=http://127.0.0.1:7070
# Optional DUT origin exposed through the frontend environment configuration.
VITE_DUT_API_BASE_URL=http://127.0.0.1:9001

# Display defaults and optional PrimeUI license.
VITE_APP_TITLE=Loading...
VITE_APP_VERSION=1.0.0
VITE_PRIMEUI_LICENSE_KEY=

# Frontend analytics flag. Sentry settings are placeholders for a Sentry integration.
VITE_ENABLE_ANALYTICS=false
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.0

# Optional guest-login defaults; these are public if included in a frontend build.
VITE_GUEST_API_USERNAME=
VITE_GUEST_API_PASSWORD=

# Direct iPLAS client port and timeout in seconds. This timeout is separate from
# the backend proxy's IPLAS_API_TIMEOUT.
VITE_IPLAS_API_PORT=32678
VITE_IPLAS_API_TIMEOUT=60
# Optional direct-client URL overrides; leave empty to use the selected server and port.
VITE_IPLAS_V1_API_BASE_URL=
VITE_IPLAS_V2_API_BASE_URL=

# Default iPLAS site hosts; saved browser settings may override these values.
VITE_IPLAS_API_PTB_BASE_URL=http://10.176.33.89
VITE_IPLAS_API_PSZ_BASE_URL=http://172.24.255.25
VITE_IPLAS_API_PXD_BASE_URL=http://172.18.212.129
VITE_IPLAS_API_PVN_BASE_URL=http://10.177.240.150
VITE_IPLAS_API_PTY_BASE_URL=http://172.18.212.129

# Optional client-visible token defaults. Prefer server-managed tokens for private credentials.
VITE_IPLAS_API_TOKEN_PTB=
VITE_IPLAS_API_TOKEN_PSZ=
VITE_IPLAS_API_TOKEN_PXD=
VITE_IPLAS_API_TOKEN_PVN=
VITE_IPLAS_API_TOKEN_PTY=